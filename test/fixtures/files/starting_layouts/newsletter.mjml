<mjml>
  <mj-head>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#111827" />
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#f3f4f6">
    <mj-section background-color="#ffffff" padding="16px 0px 0px">
      <mj-column>
        <mj-image src="https://placehold.co/240x64/e5e7eb/6b7280.png?text=Logo" alt="Logo" padding="10px 25px" width="120px" align="center" />
        <mj-navbar align="center">
          <mj-navbar-link href="https://example.com/news" color="#111827" font-size="14px" padding="10px 15px">News</mj-navbar-link>
          <mj-navbar-link href="https://example.com/events" color="#111827" font-size="14px" padding="10px 15px">Events</mj-navbar-link>
          <mj-navbar-link href="https://example.com/contact" color="#111827" font-size="14px" padding="10px 15px">Contact</mj-navbar-link>
        </mj-navbar>
      </mj-column>
    </mj-section>
    <mj-raw><!-- nuntius:content --></mj-raw>
    <mj-section background-color="#ffffff" padding="0px">
      <mj-column>
        <mj-image src="https://placehold.co/1200x500/dbeafe/1e3a8a.png?text=This+month" padding="0px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="20px 0px">
      <mj-column>
        <mj-text padding="10px 25px"><h1 style="margin:0;font-size:2em;line-height:1.25">This month's news</h1><p style="margin:0">A short introduction to this edition: what's new, and what's coming up.</p></mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0px 0px 20px">
      <mj-column>
        <mj-image src="https://placehold.co/600x400/e5e7eb/6b7280.png?text=Article" padding="10px 25px" />
        <mj-text padding="10px 25px"><h3 style="margin:0;font-size:1.25em;line-height:1.25">First article</h3><p style="margin:0">A few lines about the first article.</p></mj-text>
        <mj-button href="https://example.com/news/1" background-color="#2563eb" color="#ffffff" border-radius="6px" inner-padding="12px 24px" padding="10px 25px" font-weight="600" align="left">Read more</mj-button>
      </mj-column>
      <mj-column>
        <mj-image src="https://placehold.co/600x400/e5e7eb/6b7280.png?text=Article" padding="10px 25px" />
        <mj-text padding="10px 25px"><h3 style="margin:0;font-size:1.25em;line-height:1.25">Second article</h3><p style="margin:0">A few lines about the second article.</p></mj-text>
        <mj-button href="https://example.com/news/2" background-color="#2563eb" color="#ffffff" border-radius="6px" inner-padding="12px 24px" padding="10px 25px" font-weight="600" align="left">Read more</mj-button>
      </mj-column>
    </mj-section>
    <mj-raw><!-- /nuntius:content --></mj-raw>
    <mj-section padding="20px 0px">
      <mj-column>
        <mj-social mode="horizontal" align="center" icon-size="24px" padding="10px 25px">
          <mj-social-element name="facebook" href="https://facebook.com/"></mj-social-element>
          <mj-social-element name="instagram" href="https://instagram.com/"></mj-social-element>
          <mj-social-element name="linkedin" href="https://linkedin.com/"></mj-social-element>
        </mj-social>
        <mj-text padding="4px 25px" align="center" font-size="12px" color="#6b7280"><p style="margin:0">Your company · Street 1 · 1234 AB City</p></mj-text>
        <mj-text align="center" padding="4px 25px" font-size="12px" color="#6b7280"><a href="{% raw %}{{message_url}}{% endraw %}" data-nuntius-tracking="false" style="color:inherit;text-decoration:underline;">View this email in your browser</a></mj-text>
        <mj-raw>{% if subscriber_url %}</mj-raw>
        <mj-text align="center" padding="4px 25px" font-size="12px" color="#6b7280"><a href="{{ subscriber_url }}" data-nuntius-tracking="false" style="color:inherit;text-decoration:underline;">Manage your subscription</a></mj-text>
        <mj-raw>{% endif %}</mj-raw>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>