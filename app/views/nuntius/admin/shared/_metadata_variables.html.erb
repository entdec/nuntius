<%# Metadata variables a design still uses (see Nuntius::MetadataVariables), with what to do about them %>
<% if variables.any? %>
  <div class="col-span-12 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="status">
    <p class="mb-1"><%= message %></p>
    <ul class="list-disc pl-5">
      <% variables.each do |variable, value| %>
        <li>
          <code><%= "{{ #{variable} }}" %></code>
          <% if value.present? %>
            <%= t("nuntius.admin.shared.metadata_variables.value_html", value: tag.code(value)) %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <p class="mt-1"><%= t("nuntius.admin.shared.metadata_variables.instead") %></p>
  </div>
<% end %>
