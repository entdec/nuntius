= sts.form_for([:admin, @locale]) do |f|
  = sts.card :nuntius_admin_locales, icon: 'fal fa-language' do |card|
    - card.with_action
      = f.continue
    - card.with_action
      = f.submit

    .grid.grid-cols-12.gap-4
      .col-span-12
        = f.input :key
      .col-span-12
        = entdec_code_editor f, :data_yaml, lang: "yaml", label: t('.data')
