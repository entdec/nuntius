- present(@template, TemplatePresenter) do |template|
  / An email in the editor has everything in its root's Inspect (app/javascript/nuntius/blocks/email.js),
  / the trigger and its layout as slots; the others, and an email still on an old layout, have the Edit tab.
  - designed = @template.email? && @template.layout && !@template.old_layout
  = sts.form_for([:admin, @template]) do |f|
    / The description is made from the trigger's sentence and conditions, until one is typed (see the description controller).
    / Variable pickers, Liquid fields and the email editor follow the class chosen (see the variables controller).
    div data-controller="nuntius--description nuntius--variables" data-nuntius--description-if-value=t(".description_if") data-nuntius--description-and-value=t("entdec.conditions.and") data-nuntius--description-or-value=t(".description_or") *nuntius_variables_data(f, template.klass_options.map(&:last))
      / The description is the card's title, editable in place
      - title = capture do
        - if designed
          .nuntius-title
            = f.text_field :description, class: "nuntius-title__input", placeholder: Nuntius::Template.human_attribute_name(:description), "aria-label" => Nuntius::Template.human_attribute_name(:description), data: {"nuntius--description-target" => "field"}
            label.nuntius-description-auto.nuntius-title__auto
              = f.check_box :auto_description, data: {"nuntius--description-target" => "auto", action: "nuntius--description#fill"}
              span = t(".description_auto")
          - if @template.errors[:description].any?
            p.mt-1.text-sm.font-normal.text-red-600 role="alert" = @template.errors.full_messages_for(:description).to_sentence
        - else
          = t(".card.nuntius_admin_templates.title")
      = sts.card :nuntius_admin_templates, icon: 'fal fa-file', title: title do |card|
        - if @template.new_record? && @back_path
          - card.with_action
            = link_to t('nuntius.admin.templates.new.back'), @back_path, class: "button"
        - if designed
          - card.with_action
            .nuntius-enabled = f.input :enabled, as: :switch
        - card.with_action
          = f.continue
        - card.with_action
          = f.submit

        - if designed
          - card.with_tab :design, padding: true
            - if @template.metadata_variables.any?
              .mb-4.grid.grid-cols-12.gap-4
                = render "nuntius/admin/shared/metadata_variables", variables: @template.metadata_variables, message: t(".metadata_variables")
            - slots = capture do
              div data-tess-edit-target="slot" data-tess-edit-slot="trigger" data-open=(@template.new_record? || nil) hidden=true
                = render "trigger", f: f, template: template
                / The card's Enabled again, in step with it
                .mt-4 data-controller="nuntius--mirror" data-nuntius--mirror-for-value="template[enabled]"
                  = f.input :enabled, as: :switch, input_html: {name: nil, id: "template_enabled_when"}
                - if Nuntius.config.can_create_global
                  .mt-4 = f.input :global, as: :switch, hint: t('.global_hint')
              div data-tess-edit-target="slot" data-tess-edit-slot="layout" hidden=true
                = f.association :layout, collection: @layouts, include_blank: false, label: false, hint: t('.layout_moves')
            = render "nuntius/admin/shared/email_editor", record: @template, name: "template", document: @template.editor_document, lock: Nuntius::Concerns::EmailDesigned::EDITOR_LOCK, media_url: (media_admin_template_path(@template) if @template.persisted?), variables: @template.variable_roots, translations_url: (translations_admin_template_path(@template) if @template.persisted?), options: {template: true}, attributes: %i[from to subject], slots: slots

        - else
          - card.with_tab :edit, padding: true
            - if @template.metadata_variables.any?
              .mb-6.grid.grid-cols-12.gap-4
                = render "nuntius/admin/shared/metadata_variables", variables: @template.metadata_variables, message: t(".metadata_variables")

            = render "trigger", f: f, template: template

            .mt-4.grid.grid-cols-12.gap-4
              .col-span-1
                = f.input :enabled, as: :switch
              div class=(Nuntius.config.can_create_global ? "col-span-9 relative" : "col-span-11 relative")
                label.nuntius-description-auto
                  = f.check_box :auto_description, data: {"nuntius--description-target" => "auto", action: "nuntius--description#fill"}
                  span = t(".description_auto")
                = f.input :description, input_html: {data: {"nuntius--description-target" => "field"}}
              - if Nuntius.config.can_create_global
                .col-span-2
                  = f.input :global, as: :switch, hint: t('.global_hint')

              .col-span-6
                = nuntius_liquid_field f do
                  = f.input :from
              .col-span-6
                = nuntius_liquid_field f do
                  = f.input :to

              / Old layouts read their values from the template's metadata
              - if @template.old_layout
                .col-span-12
                  = entdec_code_editor f, :metadata_yaml, lang: "yaml", label: t('.metadata')

              - if @template.transport == 'mail'
                .col-span-6
                  = f.input :link_tracking, as: :switch
                .col-span-6
                  = f.input :open_tracking, as: :switch
                - if @template.old_layout
                  .col-span-12.rounded-md.border.border-gray-200.p-4
                    p.mb-3.text-sm.text-gray-600 = t('.old_layout', name: @template.old_layout.name)
                    .mb-3.grid.grid-cols-12
                      = render "nuntius/admin/shared/metadata_variables", variables: Nuntius::MetadataVariables.in(@template, @template.old_layout.data, @template.html), message: t('.old_layout_metadata_variables')
                    - if @template.errors[:base].any?
                      .mb-3.rounded-md.border.border-red-200.bg-red-50.px-3.py-2.text-sm.text-red-700 role="alert"
                        - @template.errors[:base].each do |problem|
                          p = problem
                    = f.association :layout, collection: @layouts, include_blank: true, label: t('.convert_layout'), hint: t('.convert_hint')
                    button.button.border-transparent.bg-red-600.text-white.hover:bg-red-700 type="submit" formaction=convert_admin_template_path(@template) onclick="return confirm('#{j t('.convert_confirm')}')" = t('.convert')
                  .col-span-12
                    = nuntius_liquid_field f do
                      = entdec_code_editor f, :subject, lang: "liquid"
                  .col-span-12
                    = nuntius_liquid_field f do
                      = entdec_code_editor f, :html, lang: "markdown", height: "400px"
                - else
                  .col-span-12
                    = f.association :layout, collection: @layouts, include_blank: true, hint: t('.layout_hint')

              / TwiML, see Voice in the README
              - if @template.transport == 'voice'
                .col-span-12
                  = nuntius_liquid_field f do
                    = entdec_code_editor f, :text, lang: "liquid", height: "400px"
              - if @template.transport == 'slack'
                .col-span-12
                  = nuntius_liquid_field f do
                    = entdec_code_editor f, :text, lang: "liquid", height: "400px"
                .col-span-12
                  = nuntius_liquid_field f do
                    = entdec_code_editor f, :payload, lang: "yaml", hint: 'See here for more information: https://app.slack.com/block-kit-builder/', height: "400px"

              - if @template.transport == 'sms'
                .col-span-12
                  = nuntius_liquid_field f do
                    = f.input :text, as: :text, input_html: {rows: 4}
              - if @template.transport == 'push'
                .col-span-12
                  = nuntius_liquid_field f do
                    = f.input :text, as: :text, input_html: {rows: 4}
              - if @template.transport == 'teams'
                .col-span-12
                  = nuntius_liquid_field f do
                    = f.input :text, as: :text, input_html: {rows: 10}
                .col-span-12
                  = nuntius_liquid_field f do
                    = entdec_code_editor f, :payload, lang: "yaml", hint: 'See here for more information: https://www.adaptivecards.io/designer/', height: "400px"

        - if @template.persisted? && @template.email?
          - card.with_tab :media, padding: true
            = f.attachments :images

        - if @template.persisted?
          - card.with_tab :translations, padding: true
            = render "nuntius/admin/shared/translations", record: @template, url: translations_admin_template_path(@template)

        - if @template.messages.exists?
          - card.with_tab :messages, padding: false
            = sts.table :"nuntius/messages", params: { template_id: @template.id }
