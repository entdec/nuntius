
- present(@template, TemplatePresenter) do |template|
  = sts.form_for([:admin, @template]) do |f|
    = sts.card :nuntius_admin_templates, icon: 'fal fa-file' do |card|
      - card.with_action
        = f.continue
      - card.with_action
        = f.submit

      - card.with_tab :edit, padding: true
        / The description is made from the sentence and conditions below, until one is typed (see the description controller)
        div data-controller="nuntius--description" data-nuntius--description-if-value=t(".description_if") data-nuntius--description-and-value=t("entdec.conditions.and") data-nuntius--description-or-value=t(".description_or")
          - if @template.metadata_variables.any?
            .mb-6.grid.grid-cols-12.gap-4
              = render "nuntius/admin/shared/metadata_variables", variables: @template.metadata_variables, message: t(".metadata_variables")

          / Reads as a sentence of pills (see TemplatePresenter): send via [mail] based on [an event] when [Order] [is shipped],
          / or based on [time] when [User] [Born on] [is in] [4] [weeks] [every year]
          / Variable pickers and Liquid fields follow the class chosen (see the variables controller)
          .grid.grid-cols-12.gap-4 data-controller='toggle nuntius--variables' *nuntius_variables_data(f, template.klass_options.map(&:last))
            .col-span-12.flex.flex-wrap.items-center.gap-x-2.gap-y-2.text-sm.text-gray-700 data-nuntius--description-target="sentence"
              span data-description-skip=true = t('.send_via')
              = entdec_pill_select f, :transport, nuntius_transport_options, select_html: { "data-toggle-target" => 'input' }
              span data-description-skip=true = t('.based_on')
              / contents: the nested toggles' fields wrap as part of the sentence
              .contents data-controller='toggle'
                .contents data-description-skip=true
                  = entdec_pill_select f, :based_on, template.based_on_options, tone: :operator, select_html: { "data-toggle-target" => 'input' }
                span = t('.when')
                = entdec_pill_select f, :klass, template.klass_options, selected: @template.klass, tone: :neutral
                .contents data-toggle-target="insertion"

                / [is shipped], or a Custom event's scope#event
                template data-toggle-target='toggleable' data-toggle-value='event'
                  .contents data-controller='nuntius--chained-select' data-nuntius--chained-select-to-value='template[klass]'
                    .contents data-nuntius--chained-select-target='list'
                      = entdec_pill_select f, :event, template.event_options
                    .contents data-nuntius--chained-select-target='text'
                      = f.text_field :event, class: 'entdec-pill-input entdec-pill-input--wide', placeholder: 'scope#event', "aria-label" => Nuntius::Template.human_attribute_name(:event)

                / [Born on] [is in] [4] [weeks] [every year], or a timebased_scope's [after created] [2] [days]
                template data-toggle-target='toggleable' data-toggle-value='time'
                  .contents data-controller='toggle' data-toggle-attr='data-kind'
                    .contents data-controller='nuntius--chained-select' data-nuntius--chained-select-to-value='template[klass]'
                      .contents data-nuntius--chained-select-target='list'
                        = entdec_pill_select f, :timestamp, template.timestamp_options, tone: :neutral, select_html: { "data-toggle-target" => 'input' }
                    .contents data-toggle-target="insertion"
                    template data-toggle-target='toggleable' data-toggle-value='scope'
                      = render "interval", f: f, template: template
                    template data-toggle-target='toggleable' data-toggle-value='timestamp'
                      .contents data-controller='toggle'
                        = entdec_pill_select f, :direction, template.direction_options, tone: :operator, select_html: { "data-toggle-target" => 'input' }
                        = render "interval", f: f, template: template
                        .contents data-toggle-target="insertion"
                        template data-toggle-target='toggleable' data-toggle-value='after'
                          span = t('.ago')
                      = entdec_pill_select f, :recurrence, template.recurrence_options
            - sentence_errors = %i[klass event interval recurrence].flat_map { |attribute| @template.errors.full_messages_for(attribute) }
            - if sentence_errors.any?
              .col-span-12.text-sm.text-red-600 role="alert" = sentence_errors.to_sentence

            / If [all] of the following conditions are met: [Order › State] [is] [shipped]
            .col-span-12
              = nuntius_conditions f

            .col-span-1
              = f.input :enabled, as: :switch
            div class=(Nuntius.config.can_create_global ? "col-span-9 relative" : "col-span-11 relative")
              label.nuntius-description-auto
                = f.check_box :auto_description, data: {"nuntius--description-target" => "auto", action: "nuntius--description#fill"}
                span = t(".description_auto")
              = f.input :description, input_html: {data: {"nuntius--description-target" => "field"}}
            - if Nuntius.config.can_create_global
              .col-span-2
                = f.input :global, as: :switch, hint: t('.global_hint')

            .col-span-6
              = nuntius_liquid_field f do
                = f.input :from
            .col-span-6
              = nuntius_liquid_field f do
                = f.input :to

            .col-span-12
              .grid.grid-cols-12.gap-4 data-toggle-target="insertion"

            / Old layouts read their values from the template's metadata
            - if @template.old_layout
              .col-span-12
                = entdec_code_editor f, :metadata_yaml, lang: "yaml", label: t('.metadata')

            - Nuntius::Concerns::EmailDesigned::EMAIL_TRANSPORTS.each do |transport|
              template data-toggle-target='toggleable' data-toggle-value=transport
                .col-span-6
                  = f.input :link_tracking, as: :switch
                .col-span-6
                  = f.input :open_tracking, as: :switch
                - if @template.old_layout
                  .col-span-12.rounded-md.border.border-gray-200.p-4
                    p.mb-3.text-sm.text-gray-600 = t('.old_layout', name: @template.old_layout.name)
                    .mb-3.grid.grid-cols-12
                      = render "nuntius/admin/shared/metadata_variables", variables: Nuntius::MetadataVariables.in(@template, @template.old_layout.data, @template.html), message: t('.old_layout_metadata_variables')
                    - if @template.errors[:base].any?
                      .mb-3.rounded-md.border.border-red-200.bg-red-50.px-3.py-2.text-sm.text-red-700 role="alert"
                        - @template.errors[:base].each do |problem|
                          p = problem
                    = f.association :layout, collection: @layouts, include_blank: true, label: t('.convert_layout'), hint: t('.convert_hint')
                    button.button.border-transparent.bg-red-600.text-white.hover:bg-red-700 type="submit" formaction=convert_admin_template_path(@template) onclick="return confirm('#{j t('.convert_confirm')}')" = t('.convert')
                  .col-span-12
                    = nuntius_liquid_field f do
                      = entdec_code_editor f, :subject, lang: "liquid"
                  .col-span-12
                    = nuntius_liquid_field f do
                      = entdec_code_editor f, :html, lang: "markdown", height: "400px"
                - else
                  .col-span-12
                    = f.association :layout, collection: @layouts, include_blank: true, hint: t('.layout_hint')

            / TwiML, see Voice in the README
            template data-toggle-target='toggleable' data-toggle-value='voice'
              .col-span-12
                = nuntius_liquid_field f do
                  = entdec_code_editor f, :text, lang: "liquid", height: "400px"
            template data-toggle-target='toggleable' data-toggle-value='slack'
              .col-span-12
                = nuntius_liquid_field f do
                  = entdec_code_editor f, :text, lang: "liquid", height: "400px"
              .col-span-12
                = nuntius_liquid_field f do
                  = entdec_code_editor f, :payload, lang: "yaml", hint: 'See here for more information: https://app.slack.com/block-kit-builder/', height: "400px"

            template data-toggle-target='toggleable' data-toggle-value='sms'
              .col-span-12
                = nuntius_liquid_field f do
                  = f.input :text, as: :text, input_html: {rows: 4}
            template data-toggle-target='toggleable' data-toggle-value='push'
              .col-span-12
                = nuntius_liquid_field f do
                  = f.input :text, as: :text, input_html: {rows: 4}
            template data-toggle-target='toggleable' data-toggle-value='teams'
              .col-span-12
                = nuntius_liquid_field f do
                  = f.input :text, as: :text, input_html: {rows: 10}
              .col-span-12
                = nuntius_liquid_field f do
                  = entdec_code_editor f, :payload, lang: "yaml", hint: 'See here for more information: https://www.adaptivecards.io/designer/', height: "400px"


      - if @template.email? && @template.layout && !@template.old_layout
        - card.with_tab :design, padding: true
          = render "nuntius/admin/shared/email_editor", record: @template, name: "template", document: @template.editor_document, lock: Nuntius::Concerns::EmailDesigned::EDITOR_LOCK, media_url: (media_admin_template_path(@template) if @template.persisted?), variables: @template.variable_roots

      - if @template.persisted? && @template.email?
        - card.with_tab :media, padding: true
          = f.attachments :images

      - if @template.messages.exists?
        - card.with_tab :messages, padding: false
          = sts.table :"nuntius/messages", params: { template_id: @template.id }
