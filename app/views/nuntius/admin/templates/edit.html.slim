
- present(@template, TemplatePresenter) do |template|
  = sts.form_for([:admin, @template]) do |f|
    = sts.card :nuntius_admin_templates, icon: 'fal fa-file' do |card|
      - card.with_action
        = f.continue
      - card.with_action
        = f.submit

      - card.with_tab :edit, padding: true
        .grid.grid-cols-12.gap-4
          = render "nuntius/admin/shared/metadata_variables", variables: @template.metadata_variables, message: t(".metadata_variables")
          .col-span-1
            = f.input :enabled, as: :switch
          - if Nuntius.config.can_create_global
            .col-span-9
              = f.input :description
            .col-span-2
              = f.input :global, as: :switch, hint: t('.global_hint')
          - else
            .col-span-11
              = f.input :description

        .grid.grid-cols-12.gap-4 data-controller='toggle'
          .col-span-6
            = f.input :klass, collection: Nuntius.config.nuntiable_class_names.sort, selected: @template.klass, input_html: { data: { 'toggle-target' => 'input' } }

          .col-span-6 data-toggle-target="insertion"

          template data-toggle-target='toggleable' data-toggle-not-value='Custom'
            .col-span-6 data-controller='toggle' data-toggle-attr='data-timebased'
              .grid.grid-cols-12.gap-4
                .col-span-6
                  = f.input :event, collection: template.all_events, include_blank: false, chain_to: 'template[klass]', input_html: { data: { 'toggle-target' => 'input' } }, as: :dropdown
                .col-span-6 data-toggle-target="insertion"
              template data-toggle-target='toggleable' data-toggle-value='Y'
                = f.input :interval

          template data-toggle-target='toggleable' data-toggle-value='Custom'
            .col-span-6
              = f.input :event, input_html: { placeholder: 'scope#event' }

        .grid.grid-cols-12.gap-4 data-controller='toggle'

          .col-span-12
            = f.input :transport, collection: Nuntius.config.transports, include_blank: false, input_html: { "data-toggle-target" => 'input' }

          .col-span-6
            = f.input :from
          .col-span-6
            = f.input :to

          .col-span-12
            .grid.grid-cols-12.gap-4 data-toggle-target="insertion"

          / Old layouts read their values from the template's metadata
          - if @template.old_layout
            .col-span-12
              = f.input :metadata_yaml, as: :editor, mode: 'application/yaml', label: t('.metadata')

          - Nuntius::Concerns::EmailDesigned::EMAIL_TRANSPORTS.each do |transport|
            template data-toggle-target='toggleable' data-toggle-value=transport
              .col-span-6
                = f.input :link_tracking, as: :switch
              .col-span-6
                = f.input :open_tracking, as: :switch
              - if @template.old_layout
                .col-span-12.rounded-md.border.border-gray-200.p-4
                  p.mb-3.text-sm.text-gray-600 = t('.old_layout', name: @template.old_layout.name)
                  .mb-3.grid.grid-cols-12
                    = render "nuntius/admin/shared/metadata_variables", variables: Nuntius::MetadataVariables.in(@template, @template.old_layout.data, @template.html), message: t('.old_layout_metadata_variables')
                  - if @template.errors[:base].any?
                    .mb-3.rounded-md.border.border-red-200.bg-red-50.px-3.py-2.text-sm.text-red-700 role="alert"
                      - @template.errors[:base].each do |problem|
                        p = problem
                  = f.association :layout, collection: @layouts, include_blank: true, label: t('.convert_layout'), hint: t('.convert_hint')
                  button.button.border-transparent.bg-red-600.text-white.hover:bg-red-700 type="submit" formaction=convert_admin_template_path(@template) onclick="return confirm('#{j t('.convert_confirm')}')" = t('.convert')
                .col-span-12
                  = f.input :subject, as: :editor, mode: 'text/plain'
                .col-span-12
                  = f.input :html, as: :editor, mode: 'text/markdown', height: '400px'
              - else
                .col-span-12
                  = f.association :layout, collection: @layouts, include_blank: true, hint: t('.layout_hint')

          template data-toggle-target='toggleable' data-toggle-value='voice'
            .col-span-12
              = f.input :text, as: :editor, mode: 'text/plain', height: '400px'
          template data-toggle-target='toggleable' data-toggle-value='slack'
            .col-span-12
              = f.input :text, as: :editor, mode: 'text/plain', height: '400px'
            .col-span-12
              = f.input :payload, as: :editor, mode: 'application/yaml', hint: 'See here for more information: https://app.slack.com/block-kit-builder/', height: '400px'

          template data-toggle-target='toggleable' data-toggle-value='sms'
            .col-span-12
              = f.input :text, as: :editor, mode: 'text/plain'
          template data-toggle-target='toggleable' data-toggle-value='push'
            .col-span-12
              = f.input :text, as: :editor, mode: 'text/plain'
          template data-toggle-target='toggleable' data-toggle-value='teams'
            .col-span-12
              = f.input :text, as: :editor, mode: 'text/plain', height: '400px'
            .col-span-12
              = f.input :payload, as: :editor, mode: 'application/yaml', hint: 'See here for more information: https://www.adaptivecards.io/designer/', height: '400px'


      - if @template.email? && @template.layout && !@template.old_layout
        - card.with_tab :design, padding: true
          = render "nuntius/admin/shared/email_editor", record: @template, name: "template", document: @template.editor_document, lock: Nuntius::Concerns::EmailDesigned::EDITOR_LOCK, media_url: media_admin_template_path(@template)

      - if @template.persisted? && @template.email?
        - card.with_tab :media, padding: true
          = f.attachments :images

      - if @template.messages.exists?
        - card.with_tab :messages, padding: false
          = sts.table :"nuntius/messages", params: { template_id: @template.id }
