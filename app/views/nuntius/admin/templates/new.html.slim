/ What to send, then for an email which layout to start from, as cards
/ linking to the editor for a new template (see TemplatesController#new)
- card_class = "flex h-full flex-col rounded-lg border border-gray-200 bg-white transition hover:border-blue-600 hover:ring-2 hover:ring-blue-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300"
- description = @transport == "mail" ? "#{nuntius_transport_name('mail')} › #{t('.which_layout')}" : t('.what')
= sts.card :nuntius_admin_templates, icon: 'fal fa-file', title: t('.title'), description: description do |card|
  - if @transport == "mail" && !@transports.one?
    - card.with_action
      = link_to t('.back'), new_admin_template_path, class: "button"
  - if @transport == "mail"
    .grid.grid-cols-1.gap-4.sm:grid-cols-2.lg:grid-cols-3
      - layouts = @layouts.order(:name).to_a
      - if layouts.empty?
        = link_to new_admin_layout_path, class: "flex h-full flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-gray-300 px-4 py-12 text-center hover:border-gray-400" do
          span.text-sm.text-gray-500 = t('.no_layouts')
          span.font-medium.text-blue-600 = t('.create_layout')
      - layouts.each do |layout|
        = link_to new_admin_template_path(transport: "mail", layout_id: layout.id), class: "#{card_class} overflow-hidden" do
          / The email at half its size, centred; looked at, not used
          .pointer-events-none.relative.h-64.overflow-hidden.border-b.border-gray-200.bg-gray-50
            iframe.absolute.top-0.border-0 srcdoc=layout.preview_html sandbox="" loading="lazy" tabindex="-1" title=layout.name style="left: 50%; width: 600px; height: 1000px; margin-left: -150px; transform: scale(0.5); transform-origin: top left;"
          .flex.flex-col.gap-1.px-4.py-3
            span.font-medium.text-gray-900 = layout.name
            - if layout.description.present?
              span.text-sm.text-gray-500 = layout.description
  - else
    .grid.grid-cols-1.gap-4.sm:grid-cols-2.lg:grid-cols-3
      - @transports.each do |transport|
        = link_to new_admin_template_path(transport: transport), class: "#{card_class} items-center gap-2 px-4 py-8 text-center" do
          span.text-3xl.text-gray-700 = nuntius_transport_icon(transport)
          span.font-medium.text-gray-900 = nuntius_transport_name(transport)
          span.text-sm.text-gray-500 = t(transport, scope: "nuntius.transport_hints", default: "")
