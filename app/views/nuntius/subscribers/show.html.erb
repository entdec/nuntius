<%# A subscriber's subscription to a list, on the app's public layout (Nuntius.config.layout) %>
<div class="nuntius-public">
  <h1 class="nuntius-public__title"><%= @list.name %></h1>
  <div class="prose"><%= sanitize @list.description.to_s %></div>
  <div class="nuntius-public__actions">
    <% if @subscriber.unsubscribed_at.present? %>
      <%= link_to t(".resubscribe"), subscribe_subscriber_path(@subscriber), class: "button primary" %>
    <% else %>
      <%= link_to t(".unsubscribe"), unsubscribe_subscriber_path(@subscriber), class: "button primary" %>
    <% end %>
  </div>
</div>
